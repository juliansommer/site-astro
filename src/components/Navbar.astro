---
import { socials } from "@/lib/data.ts"
import { cn } from "@/lib/utils.ts"

export interface Props {
  className?: string
}

const { className } = Astro.props
---

<nav class={cn("flex items-center justify-between py-10", className)}>
  <h1
    class="-rotate-2 text-2xl font-bold text-white underline decoration-purple-500 underline-offset-8"
  >
    Julian Sommer 👨🏻‍💻
  </h1>
  <div class="item-center flex gap-5">
    {
      socials.map((social) => {
        const Icon = social.Icon
        return (
          <a href={social.link} aria-label={social.label}>
            {/* @ts-expect-error Icon is component, issue with preact/compat */}
            <Icon className="h-5 w-5 text-white transition-all hover:scale-125" />
          </a>
        )
      })
    }
  </div>
</nav>

---
import Icon from "@/components/Icon.astro"
import { skills } from "@/lib/data.ts"
---

<ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
  {skills.map(({ name, icon }) => (
    <li class="flex items-center gap-2 rounded-md border border-neutral-800 bg-neutral-900/50 py-2.5 pr-3 pl-2 text-sm text-neutral-300 transition hover:border-neutral-700 hover:text-neutral-100">
      <Icon name={icon} class="h-5 w-5 shrink-0" />
      {name}
    </li>
  ))}
</ul>

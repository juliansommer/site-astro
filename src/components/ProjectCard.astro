---
import type { Project } from "@/types/index.ts"

import Tags from "./Tags.astro"

interface Props {
  project: Project
}

const { project } = Astro.props
---

<div class="group relative pb-1 transition-all lg:group-hover/list:opacity-50 lg:hover:opacity-100!">
  <div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-neutral-900/60 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)]"></div>
  <div class="relative z-10">
    <h3 class="text-lg leading-snug font-semibold text-neutral-100">
      {project.link ? (
        <a
          href={project.link}
          class="group/link inline-flex items-baseline hover:text-sky-300 focus-visible:text-sky-300"
        >
          <span class="absolute -inset-x-4 -inset-y-2.5 hidden rounded-sm md:-inset-x-6 md:-inset-y-4 lg:block"></span>
          {project.title}
          <span
            class="ml-1 inline-block transition-transform group-hover/link:translate-x-1 group-hover/link:-translate-y-1"
            aria-hidden="true"
          >
            ↗
          </span>
        </a>
      ) : (
        project.title
      )}
    </h3>
    <p class="mt-2 text-sm leading-relaxed text-neutral-300">
      {project.description}
    </p>
    {project.bullets && (
      <ul class="mt-3 list-disc space-y-1 pl-4 text-sm leading-relaxed text-neutral-400 marker:text-neutral-600">
        {project.bullets.map((bullet) => (
          <li>{bullet}</li>
        ))}
      </ul>
    )}
    <div class="mt-4">
      <Tags items={project.tech} />
    </div>
  </div>
</div>

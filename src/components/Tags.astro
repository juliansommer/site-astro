---
interface Props {
  items: string[]
}

const { items } = Astro.props
---

<ul class="flex flex-wrap gap-2" aria-label="Technologies used">
  {items.map((item) => (
    <li class="rounded-full border border-neutral-800 bg-neutral-900 px-3 py-1 text-xs font-medium text-neutral-300">
      {item}
    </li>
  ))}
</ul>

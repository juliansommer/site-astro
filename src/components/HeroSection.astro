---
import { email } from "@/lib/data.ts"
import Title from "./Title.astro"
---

<div
  class="animate-move-up flex min-h-[60vh] flex-col-reverse items-center justify-between gap-14"
>
  <div class="flex flex-col items-center space-y-10 text-center">
    <h1 class="text-4xl font-bold text-white md:text-6xl">
      Nice to meet you! 👋
      <br />
      <span class="underline decoration-sky-500 underline-offset-8">
        Hi, I'm Julian.
      </span>
    </h1>
    <p class="w-96 text-lg text-white md:text-xl">
      I'm a fullstack developer from Australia with a passion for building
      modern web applications.
    </p>
    <a href={`mailto:${email}`} class="group inline-block">
      <Title text="Contact 📧" />
    </a>
  </div>
</div>

---
import type { Entry } from "@/types/index.ts"

import Tags from "./Tags.astro"

interface Props {
  entry: Entry
}

const { entry } = Astro.props
---

<div class="group relative pb-1 transition-all lg:group-hover/list:opacity-50 lg:hover:opacity-100!">
  <div class="absolute -inset-x-4 -inset-y-4 z-0 hidden rounded-md transition motion-reduce:transition-none lg:-inset-x-6 lg:block lg:group-hover:bg-neutral-900/60 lg:group-hover:shadow-[inset_0_1px_0_0_rgba(148,163,184,0.1)]"></div>
  <div class="relative z-10">
    <header>
      <div class="flex flex-wrap items-baseline justify-between gap-x-4">
        <h3 class="text-lg leading-snug font-semibold text-neutral-100">
          {entry.organisation}
        </h3>
        <p class="text-xs font-medium text-neutral-400">{entry.date}</p>
      </div>
      <div class="mt-0.5 flex flex-wrap items-baseline justify-between gap-x-4">
        <p class="text-sm text-neutral-300 italic">{entry.role}</p>
        <p class="text-xs text-neutral-500">{entry.location}</p>
      </div>
    </header>
    <ul class="mt-3 list-disc space-y-1 pl-4 text-sm leading-relaxed text-neutral-400 marker:text-neutral-600">
      {entry.bullets.map((bullet) => (
        <li>{bullet}</li>
      ))}
    </ul>
    {entry.tech && (
      <div class="mt-4">
        <Tags items={entry.tech} />
      </div>
    )}
  </div>
</div>

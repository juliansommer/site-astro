---
interface Props {
  id: string
  title: string
}

const { id, title } = Astro.props
---

<section id={id} class="scroll-mt-16 lg:scroll-mt-24" aria-label={title}>
  <div class="sticky top-0 z-10 -mx-6 mb-4 bg-black/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only">
    <h2 class="text-sm font-bold tracking-widest text-neutral-200 uppercase">
      {title}
    </h2>
  </div>
  <slot />
</section>

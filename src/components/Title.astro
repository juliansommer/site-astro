---
interface Props {
  text: string
  className?: string
}

const { text, className } = Astro.props
---

<div class={className}>
  <h1
    class="text-3xl font-bold text-white transition-all group-hover:text-sky-400"
  >
    {text}
  </h1>
  <div class="h-2 w-40 rounded-full bg-sky-500"></div>
  <div class="h-2 w-40 translate-x-2 rounded-full bg-purple-500"></div>
</div>
